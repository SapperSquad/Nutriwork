# nutriwork:book - give the player the Nutrition Guide (written book)
give @s written_book[written_book_content={title:"Nutrition Guide",author:"SapperSquad",resolved:true,pages:['["",{"text":"Nutriwork\\n","bold":true,"color":"dark_green"},{"text":"a nutrition guide\\n\\n","italic":true,"color":"dark_gray"},{"text":"Eat a balanced diet across the six food groups to earn passive buffs. This guide shows how.","color":"black"}]','["",{"text":"The Six Groups\\n\\n","bold":true,"color":"dark_green"},{"text":"Fruit:","bold":true,"color":"black"},{"text":" apples, berries\\n","color":"black"},{"text":"Veg:","bold":true,"color":"black"},{"text":" carrots, potato\\n","color":"black"},{"text":"Grain:","bold":true,"color":"black"},{"text":" bread, cookies\\n","color":"black"},{"text":"Meat:","bold":true,"color":"black"},{"text":" cooked meat, fish\\n","color":"black"},{"text":"Sugar:","bold":true,"color":"black"},{"text":" cookies, honey\\n","color":"black"},{"text":"Water:","bold":true,"color":"black"},{"text":" drinks, soups","color":"black"}]','["",{"text":"Balanced-Diet Buffs\\n\\n","bold":true,"color":"dark_green"},{"text":"Keep groups at 50 or more:\\n\\n3 groups - Regeneration\\n4 groups - add Resistance\\n5 groups - add Haste\\n\\nMore groups, more buffs.","color":"black"}]','["",{"text":"Variety = Well-Fed\\n\\n","bold":true,"color":"dark_green"},{"text":"Eat 4 or more different groups within a few minutes to earn Well-Fed: a bonus Absorption heart.\\n\\nVariety beats volume.","color":"black"}]','["",{"text":"Water and Penalties\\n\\n","bold":true,"color":"dark_green"},{"text":"Let Water run low and you get Weakness, then Slowness. Drink up.\\n\\nGorge when already full and you get Stuffed: a brief Slowness.","color":"black"}]','["",{"text":"Nutrition Fades\\n\\n","bold":true,"color":"dark_green"},{"text":"Every track slowly drops over time, so eat a few times a day to stay buffed. A varied plate keeps every bar full.","color":"black"}]','["",{"text":"Your HUD\\n\\n","bold":true,"color":"dark_green"},{"text":"/trigger nw.hud cycles off, bars, actionbar.\\n\\n/function nutriwork:journal shows your diet and buffs.\\n\\nHide a bar with /function nutriwork:hud/bar/sugar","color":"black"}]','["",{"text":"Eat well.\\n\\n","bold":true,"color":"dark_green"},{"text":"- SapperSquad","italic":true,"color":"dark_gray"}]']}]
tellraw @s [{"text":"[Nutriwork] ","color":"green","bold":true},{"text":"Added the Nutrition Guide to your inventory.","color":"gray","bold":false}]
