# macro: text labels ("Fruit 60") + bar fill. Vanilla-safe, no resource pack needed.
$bossbar set nutriwork:h$(id)_fruit name [{"text":"Fruit ","color":"red"},{"text":"$(fruit)","color":"white"}]
$bossbar set nutriwork:h$(id)_fruit value $(fruit)
$bossbar set nutriwork:h$(id)_veg name [{"text":"Veg ","color":"green"},{"text":"$(veg)","color":"white"}]
$bossbar set nutriwork:h$(id)_veg value $(veg)
$bossbar set nutriwork:h$(id)_grain name [{"text":"Grain ","color":"yellow"},{"text":"$(grain)","color":"white"}]
$bossbar set nutriwork:h$(id)_grain value $(grain)
$bossbar set nutriwork:h$(id)_meat name [{"text":"Meat ","color":"light_purple"},{"text":"$(meat)","color":"white"}]
$bossbar set nutriwork:h$(id)_meat value $(meat)
$bossbar set nutriwork:h$(id)_sugar name [{"text":"Sugar ","color":"light_purple"},{"text":"$(sugar)","color":"white"}]
$bossbar set nutriwork:h$(id)_sugar value $(sugar)
$bossbar set nutriwork:h$(id)_water name [{"text":"Water ","color":"aqua"},{"text":"$(water)","color":"white"}]
$bossbar set nutriwork:h$(id)_water value $(water)
