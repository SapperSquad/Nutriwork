# macro: set visibility of all six bars. $(vis) = "true" / "false".
$bossbar set nutriwork:h$(id)_fruit visible $(vis)
$bossbar set nutriwork:h$(id)_veg visible $(vis)
$bossbar set nutriwork:h$(id)_grain visible $(vis)
$bossbar set nutriwork:h$(id)_meat visible $(vis)
$bossbar set nutriwork:h$(id)_sugar visible $(vis)
$bossbar set nutriwork:h$(id)_water visible $(vis)
