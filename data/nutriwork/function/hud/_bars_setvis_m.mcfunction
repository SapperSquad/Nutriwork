# macro: apply each bar's visibility. $(vf..vw) = "true"/"false" per track.
$bossbar set nutriwork:h$(id)_fruit visible $(vf)
$bossbar set nutriwork:h$(id)_veg visible $(vv)
$bossbar set nutriwork:h$(id)_grain visible $(vg)
$bossbar set nutriwork:h$(id)_meat visible $(vm)
$bossbar set nutriwork:h$(id)_sugar visible $(vs)
$bossbar set nutriwork:h$(id)_water visible $(vw)
